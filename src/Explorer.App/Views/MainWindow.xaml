<Window x:Class="Explorer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:panes="clr-namespace:Explorer.App.Views.Panes"
        Title="2x2 Explorer"
        Icon="pack://application:,,,/Resources/app.ico"
        MinWidth="900"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewMouseMove="OnWindowMouseMove"
        StateChanged="OnWindowStateChanged">

    <!--
        창 테두리를 우리가 그립니다.
        제목 높이를 0으로 두면 윈도우가 제목 줄을 그리지 않고, 가장자리 끌어 크기 조절은 그대로 남습니다.
        최대화했을 때 작업 표시줄을 덮지 않는 것도 이 덕분입니다.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>

        <!--
            칸이 놓이는 자리입니다. 분할 방식에 따라 코드에서 다시 짭니다.
            어느 방식이든 2×2 격자 위에 놓입니다. 칸을 옆이나 아래로 이어 붙이면 3분할과 2분할이 됩니다.
        -->
        <Grid x:Name="PaneArea" Margin="6" />

        <!--
            위쪽 띠입니다. 제목 줄과 전체 메뉴가 여기 함께 들어 있습니다.
            평소에는 접혀 있고, 마우스를 창 맨 위에 대면 내려옵니다.
            네 칸 위에 겹쳐 두므로 띠가 나타나도 화면이 밀리지 않습니다.
        -->
        <Border x:Name="TopBar"
                SizeChanged="OnTopBarSizeChanged"
                VerticalAlignment="Top"
                Height="40"
                Visibility="Collapsed"
                Background="{DynamicResource Pane.HeaderBackground}"
                BorderBrush="{DynamicResource Pane.Border}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTopBarPressed">

            <DockPanel LastChildFill="True">
                <!-- 오른쪽부터 자리를 잡습니다. 먼저 적은 것이 바깥쪽입니다. -->
                <Button x:Name="CloseButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CaptionCloseButton}"
                        Content="&#xE8BB;"
                        Click="OnCloseWindow"
                        ToolTip="닫기" />

                <Button x:Name="MaximizeButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CaptionButton}"
                        Content="&#xE922;"
                        Click="OnMaximizeWindow"
                        ToolTip="최대화" />

                <Button x:Name="MinimizeButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CaptionButton}"
                        Content="&#xE921;"
                        Click="OnMinimizeWindow"
                        ToolTip="최소화" />

                <Button x:Name="PinButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ToolIconButton}"
                        Content="&#xE718;"
                        Margin="0,0,10,0"
                        Click="OnTogglePin"
                        ToolTip="띠를 늘 보이게 두기" />

                <!--
                    설정은 톱니 아이콘 하나로 고정 핀 바로 왼쪽에 둡니다.
                    항목은 펼칠 때마다 코드에서 다시 만듭니다. 즐겨찾기가 밖에서 바뀔 수 있기 때문입니다.
                -->
                <Menu x:Name="GlobalMenu"
                      DockPanel.Dock="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,2,0"
                      Style="{StaticResource PaneMenu}">
                    <Menu.Resources>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}" />
                    </Menu.Resources>
                    <MenuItem x:Name="SettingsMenu"
                              ToolTip="설정"
                              SubmenuOpened="OnSettingsMenuOpened">
                        <MenuItem.Header>
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        </MenuItem.Header>
                    </MenuItem>
                </Menu>

                <!--
                    일괄 이름 바꾸기(베타)입니다. 인쇄와 설정 사이에 둡니다(사용자 지정 2026-09-26).
                    설정 창 [일반]의 체크로 보이고 숨깁니다. 마지막으로 누른 탐색기 칸의 지금 폴더에서 창이 열립니다.
                -->
                <Button x:Name="BatchRenameButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ToolIconButton}"
                        Content="&#xE8AC;"
                        Margin="0,0,2,0"
                        Click="OnBatchRename"
                        ToolTip="일괄 이름 바꾸기(베타) (칸 안에서는 Ctrl+Shift+R) — 표로 놓고 한꺼번에 바꿉니다.&#x0a;아직 기능이 불완전합니다. 설정 창 [일반]에서 끌 수 있습니다." />

                <!--
                    일괄 인쇄입니다. 마지막으로 누른 탐색기 칸의 탭을 들고 창이 열립니다.
                    그 탭에서 고른 파일이 있으면 담고, 없으면 빈 목록으로 엽니다.
                -->
                <Button x:Name="BatchPrintButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ToolIconButton}"
                        Content="&#xE749;"
                        Margin="0,0,2,0"
                        Click="OnBatchPrint"
                        ToolTip="일괄 인쇄 (칸 안에서는 Ctrl+P) — 이미지는 A4에 맞춰, 문서는 연결된 프로그램으로 찍습니다" />

                <!--
                    그림 편집입니다. 일괄 인쇄 바로 왼쪽에 둡니다.
                    누르면 단일 편집과 일괄 편집을 고르는 하위 메뉴가 펼쳐집니다.
                    둘 다 마지막으로 누른 탐색기 칸의 지금 탭에서 고른 파일을 들고 열립니다.
                -->
                <Menu x:Name="PhotoMenuBar"
                      DockPanel.Dock="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,2,0"
                      Style="{StaticResource PaneMenu}">
                    <Menu.Resources>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}" />
                    </Menu.Resources>
                    <MenuItem x:Name="PhotoMenu" ToolTip="그림 편집">
                        <MenuItem.Header>
                            <TextBlock Text="&#xEB9F;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        </MenuItem.Header>
                        <MenuItem Header="단일 편집…"
                                  Click="OnEditSingleImage"
                                  ToolTip="고른 그림 한 장을 엽니다. 고른 그림이 없으면 클립보드의 그림을 엽니다.&#x0a;자르기·크기·회전·반전 후 다른 이름으로 저장하고, 그림판으로 넘길 수 있습니다." />
                        <MenuItem Header="일괄 편집…"
                                  Click="OnEditImageBatch"
                                  ToolTip="고른 그림 여러 장에 크기·가운데 자르기·회전·형식·EXIF 편집을 한 번에 겁니다.&#x0a;원본은 두고 새 파일로 저장합니다." />
                    </MenuItem>
                </Menu>
                <!--
                    PDF 편집입니다. 그림 편집 바로 왼쪽에 둡니다.
                    마지막으로 누른 탐색기 칸에서 고른 PDF·그림을 고른 차례대로 쪽으로 넣어 엽니다.
                -->
                <Button x:Name="PdfEditorButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ToolIconButton}"
                        Content="&#xEA90;"
                        Margin="0,0,2,0"
                        Click="OnEditPdf"
                        ToolTip="PDF 편집 — 쪽 미리보기, 병합·삭제, PDF ↔ 그림 변환" />

                <!--
                    왼쪽은 아이콘과 프로그램 이름이 먼저, 그다음이 즐겨찾기 단추입니다.
                    이름은 Window.Title 을 그대로 씁니다. 이름을 바꿀 자리를 한 곳으로 두려는 것입니다.
                    아이콘은 창 아이콘과 같은 .ico 입니다. WPF 가 16px 에 맞는 프레임을 골라 씁니다.
                -->
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/Resources/app.ico"
                           Width="16"
                           Height="16"
                           Margin="0,0,8,0"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Primary}" />
                </StackPanel>


                <!--
                    즐겨찾기 단추 줄입니다. 즐겨찾기 편집 창에서 "상단"을 체크한 것만 뜹니다.
                    단추는 코드에서 만듭니다. 창이 좁아 다 들어가지 않으면 넘친 것은 » 단추의 메뉴로 모읍니다.
                -->
                <StackPanel x:Name="FavoriteBar"
                            DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0" />

                <Button x:Name="FavoriteOverflow"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ToolButton}"
                        Content="»"
                        Visibility="Collapsed"
                        Click="OnFavoriteOverflow"
                        ToolTip="자리가 모자라 숨은 즐겨찾기" />

                <!-- 남는 자리는 창을 끌어 옮기는 손잡이입니다. -->
                <Border Background="Transparent" />
            </DockPanel>
        </Border>

    </Grid>

</Window>
