<Window x:Class="Explorer.App.Views.Dialogs.NormalizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Explorer.App.Views.Dialogs"
        Title="이름 정규화"
        Width="1400"
        Height="820"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="OnWindowKeyDown"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 자동으로 짐작한 칸(프로젝트명·작성자)은 흐리고 기울여 보여, 사람이 확인할 곳을 알립니다. -->
        <Style x:Key="ProjectCell" TargetType="DataGridCell" BasedOn="{StaticResource SheetCell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProjectGuessed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="ToolTip" Value="자동으로 짐작한 값입니다. 맞는지 확인해 주십시오. 고치면 짐작 표시가 풀립니다." />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Row.Selected}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AuthorCell" TargetType="DataGridCell" BasedOn="{StaticResource SheetCell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AuthorGuessed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="ToolTip" Value="자동으로 짐작한 값입니다. 맞는지 확인해 주십시오. 고치면 짐작 표시가 풀립니다." />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Row.Selected}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OriginalCell" TargetType="DataGridCell" BasedOn="{StaticResource SheetCell}">
            <Setter Property="ToolTip" Value="{Binding Original}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Unresolved}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                    <Setter Property="ToolTip" Value="본문 말고는 요소를 찾지 못했습니다. 칸에 직접 적어 나눌 수 있습니다." />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Row.Selected}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 목표 패턴의 요소 칩 -->
        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" Margin="0,0,6,0" Padding="8,4" CornerRadius="3"
                                Background="{DynamicResource Pane.HeaderBackground}"
                                BorderBrush="{DynamicResource Pane.Border}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Row.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Row.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <local:PopupTitleBar x:Name="TitleBar" DockPanel.Dock="Top" />

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ① 분석 -->
            <TextBlock Grid.Row="0" Style="{StaticResource PaneLabel}" Text="① 현재 패턴 분석" Margin="0,0,0,4" />
            <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource DialogSmallButton}" Margin="6,0,0,0"
                        Click="OnReanalyze" Content="다시 분석"
                        ToolTip="고친 칸을 모두 버리고 원래 이름에서 다시 나눕니다." />
                <Button DockPanel.Dock="Right" Style="{StaticResource DialogSmallButton}" Margin="6,0,0,0"
                        Click="OnFillColumn" Content="이 열을 같은 값으로  Ctrl+D"
                        ToolTip="지금 칸의 값을 같은 열의 고른 줄(고른 줄이 하나면 모든 줄)에 채웁니다. 한 폴더의 프로젝트명처럼 같은 값일 때 씁니다." />
                <TextBlock x:Name="AnalysisText" Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>

            <DataGrid x:Name="Parts" Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      SelectionMode="Extended"
                      SelectionUnit="Cell"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{DynamicResource Pane.Border}"
                      VerticalGridLinesBrush="{DynamicResource Pane.Border}"
                      Background="{DynamicResource List.Background}"
                      RowBackground="Transparent"
                      Foreground="{DynamicResource Text.Primary}"
                      BorderBrush="{DynamicResource Pane.Border}"
                      BorderThickness="1"
                      FontSize="12"
                      RowHeight="24"
                      ColumnHeaderStyle="{StaticResource SheetHeader}"
                      CellStyle="{StaticResource SheetCell}"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      PreviewKeyDown="OnPartsKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="원래 이름" Width="2*" IsReadOnly="True" SortMemberPath="Original"
                                        Binding="{Binding Original, Mode=OneWay}" CellStyle="{StaticResource OriginalCell}" />
                    <DataGridTextColumn Header="순번" Width="44" SortMemberPath="Sequence"
                                        Binding="{Binding Sequence, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource SheetEditBox}" />
                    <DataGridTextColumn Header="날짜" Width="110" SortMemberPath="Date"
                                        Binding="{Binding Date, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource SheetEditBox}" />
                    <DataGridTextColumn Header="문서번호" Width="110" SortMemberPath="DocNumber"
                                        Binding="{Binding DocNumber, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource SheetEditBox}" />
                    <DataGridTextColumn Header="프로젝트명" Width="1*" SortMemberPath="Project"
                                        Binding="{Binding Project, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource SheetEditBox}"
                                        CellStyle="{StaticResource ProjectCell}" />
                    <DataGridTextColumn Header="본문(파일명)" Width="1.5*" SortMemberPath="Body"
                                        Binding="{Binding Body, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource SheetEditBox}" />
                    <DataGridTextColumn Header="버전" Width="56" SortMemberPath="Version"
                                        Binding="{Binding Version, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource SheetEditBox}" />
                    <DataGridTextColumn Header="작성자" Width="64" SortMemberPath="Author"
                                        Binding="{Binding Author, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource SheetEditBox}"
                                        CellStyle="{StaticResource AuthorCell}" />
                    <DataGridTextColumn Header="비고" Width="1*" SortMemberPath="Note"
                                        Binding="{Binding Note, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource SheetEditBox}" />
                    <DataGridTemplateColumn Header="결과 (바뀐 부분 강조)" Width="2*" IsReadOnly="True" SortMemberPath="Result">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <local:DiffText Original="{Binding Original}" Result="{Binding Result}"
                                                VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Result}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ② 목표 패턴 -->
            <TextBlock Grid.Row="3" Style="{StaticResource PaneLabel}" Text="② 목표 패턴" Margin="0,14,0,4" />
            <StackPanel Grid.Row="4">
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Style="{StaticResource ToolIconButton}" Content="&#xE72B;"
                            Click="OnOrderLeft" ToolTip="고른 요소를 앞으로" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource ToolIconButton}" Content="&#xE72A;" Margin="0,0,6,0"
                            Click="OnOrderRight" ToolTip="고른 요소를 뒤로" />
                    <Grid DockPanel.Dock="Left">
                        <ListBox x:Name="OrderList"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ChipItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="OnOrderMouseDown"
                                 PreviewMouseMove="OnOrderMouseMove"
                                 PreviewDragOver="OnOrderDragOver"
                                 PreviewDrop="OnOrderDrop"
                                 DragLeave="OnOrderDragLeave">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsOn}" Content="{Binding Label}"
                                              Foreground="{DynamicResource Text.Primary}" VerticalContentAlignment="Center"
                                              ToolTip="끄면 이 요소를 이름에서 뺍니다. 끌어서 차례를 바꿉니다." />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 끌 때 놓일 자리 -->
                        <Border x:Name="OrderDropLine" Width="2" HorizontalAlignment="Left" Background="{DynamicResource Accent}"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>

                <WrapPanel>
                    <TextBlock Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center" Text="구분자" Margin="0,0,6,6" />
                    <ComboBox x:Name="SeparatorBox" Width="100" Height="24" Margin="0,0,16,6" SelectedIndex="0"
                              SelectionChanged="OnOptionChanged">
                        <ComboBoxItem Content="_ 언더바" Tag="_" />
                        <ComboBoxItem Content="띄어쓰기" Tag=" " />
                        <ComboBoxItem Content="- 대시" Tag="-" />
                    </ComboBox>

                    <TextBlock Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center" Text="날짜 형식" Margin="0,0,6,6" />
                    <ComboBox x:Name="DateFormatBox" Width="120" Height="24" Margin="0,0,16,6" SelectedIndex="0"
                              SelectionChanged="OnOptionChanged">
                        <ComboBoxItem Content="260716" Tag="yyMMdd" />
                        <ComboBoxItem Content="20260716" Tag="yyyyMMdd" />
                        <ComboBoxItem Content="2026-07-16" Tag="yyyy-MM-dd" />
                        <ComboBoxItem Content="2026.07.16" Tag="yyyy.MM.dd" />
                    </ComboBox>

                    <TextBlock Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center" Text="버전" Margin="0,0,6,6" />
                    <ComboBox x:Name="VersionBox" Width="80" Height="24" Margin="0,0,16,6" SelectedIndex="0"
                              SelectionChanged="OnOptionChanged">
                        <ComboBoxItem Content="v2.1" Tag="v" />
                        <ComboBoxItem Content="ver2.1" Tag="ver" />
                        <ComboBoxItem Content="V2.1" Tag="V" />
                    </ComboBox>

                    <TextBlock Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center" Text="순번 자릿수" Margin="0,0,6,6" />
                    <ComboBox x:Name="SequenceBox" Width="96" Height="24" Margin="0,0,16,6" SelectedIndex="0"
                              SelectionChanged="OnOptionChanged">
                        <ComboBoxItem Content="원래대로" Tag="0" />
                        <ComboBoxItem Content="1" Tag="1" />
                        <ComboBoxItem Content="01" Tag="2" />
                        <ComboBoxItem Content="001" Tag="3" />
                    </ComboBox>

                    <CheckBox x:Name="MarkerCheck" IsChecked="True" Content="★ 같은 맨 앞 표시 남기기" Margin="0,4,16,6"
                              Foreground="{DynamicResource Text.Primary}" Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                    <CheckBox x:Name="NoteParenCheck" IsChecked="True" Content="비고를 괄호로 감싸기" Margin="0,4,16,6"
                              Foreground="{DynamicResource Text.Primary}" Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                    <CheckBox x:Name="LowerExtCheck" IsChecked="True" Content="확장자 소문자" Margin="0,4,16,6"
                              Foreground="{DynamicResource Text.Primary}" Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                </WrapPanel>
            </StackPanel>

            <!-- ③ 적용 -->
            <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
                <TextBlock x:Name="Summary" DockPanel.Dock="Left" Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="닫기" Margin="8,0,0,0" IsCancel="True" />
                <Button DockPanel.Dock="Right" Style="{StaticResource DialogPrimaryButton}" Content="③ '이름 변경 후'에 적용"
                        Click="OnApply"
                        ToolTip="결과를 일괄 이름 바꾸기 표의 '이름 변경 후' 칸에 채웁니다. 실제 이름은 그 창의 [이름 바꾸기]로 바꿉니다." />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
