<Window x:Class="Explorer.App.Views.Dialogs.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="즐겨찾기 편집"
        Width="980"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Headline"
                   Grid.Row="0"
                   Style="{StaticResource PaneSubLabel}"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Text="폴더를 열네 개까지 넣을 수 있습니다. 1~4번은 기본값이 있는 칸이라 고쳐 써도 아래 단추로 되돌릴 수 있습니다. ▲▼로 순서를 바꾸고, 비워 둔 칸은 건너뜁니다. &quot;바로가기 표시&quot;를 체크한 것만 제목 표시줄에 단추로 뜹니다. 여기 넣은 폴더는 탐색 창 맨 위에도 섭니다." />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource DialogButton}"
                    Content="1~4번 기본값으로 되돌리기"
                    Click="OnResetDefaults"
                    ToolTip="1~4번을 내 PC · 바탕 화면 · 다운로드 · 문서로 되돌리고 바로가기 표시를 켭니다. 5번부터는 그대로 둡니다." />

            <Button x:Name="CancelButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource DialogButton}"
                    Content="취소"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Click="OnCancel" />

            <Button x:Name="OkButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource DialogPrimaryButton}"
                    Content="확인"
                    IsDefault="True"
                    Click="OnOk" />
        </DockPanel>

    </Grid>

</Window>
