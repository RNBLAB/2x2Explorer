<Window x:Class="Explorer.App.Views.Dialogs.BatchImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Explorer.App.Views.Dialogs"
        Title="그림 일괄 편집"
        Width="1750"
        Height="900"
        MinWidth="1200"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AllowDrop="True"
        Drop="OnFilesDropped"
        DragOver="OnFilesDragOver"
        Closing="OnClosing"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="GroupBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Pane.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pane.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource PaneLabel}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <local:PopupTitleBar x:Name="TitleBar" DockPanel.Dock="Top" />

    <Grid>
            <!-- 왼쪽은 이 창의 기능, 오른쪽은 편집 창들이 함께 쓰는 탐색기입니다 (58 : 42). 경계선은 끌어 옮깁니다. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58*" MinWidth="560" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="42*" MinWidth="240" />
            </Grid.ColumnDefinitions>

    <Grid Margin="16" Grid.Column="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <!-- 놓는 자리 -->
        <Border Grid.Row="0" Style="{StaticResource GroupBox}" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource PaneSubLabel}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="여기에 그림 파일이나 폴더를 끌어다 놓으십시오. 원본은 건드리지 않고 새 파일로 저장합니다." />
        </Border>

        <!-- 목록과 단추 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="Items"
                      Grid.Column="0"
                      Style="{StaticResource FileListView}"
                      SelectionMode="Extended"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource FileColumnHeader}">
                        <GridViewColumn Width="46">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="#" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="320">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="파일" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="460">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="폴더" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Folder}" Foreground="{DynamicResource Text.Secondary}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" Width="120">
                <Button x:Name="AddFileButton" Style="{StaticResource DialogSmallButton}" Padding="8,5" Margin="0,0,0,6"
                        Click="OnAddFiles" Content="파일 추가" />
                <Button x:Name="AddFolderButton" Style="{StaticResource DialogSmallButton}" Padding="8,5" Margin="0,0,0,14"
                        Click="OnAddFolder" Content="폴더 추가"
                        ToolTip="폴더 바로 아래의 그림 파일만 담습니다." />
                <Button x:Name="RemoveButton" Style="{StaticResource DialogSmallButton}" Padding="8,5" Margin="0,0,0,6"
                        Click="OnRemove" Content="선택 제거" />
                <Button x:Name="ClearButton" Style="{StaticResource DialogSmallButton}" Padding="8,5" Margin="0,0,0,14"
                        Click="OnClear" Content="전체 삭제" />
                <Button x:Name="ReadExifButton" Style="{StaticResource DialogSmallButton}" Padding="8,5"
                        Click="OnReadExif" Content="EXIF 읽어 오기"
                        ToolTip="목록에서 고른 파일(없으면 첫 파일)의 EXIF 값을 아래 칸에 채웁니다. 체크는 바꾸지 않습니다." />
            </StackPanel>
        </Grid>

        <!-- 편집 설정 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 픽셀 -->
            <Border Grid.Column="0" Style="{StaticResource GroupBox}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GroupTitle}" Text="그림" />

                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="ResizeCheck" Content="크기 조정" Width="150" Margin="0,0,6,0" />
                        <ComboBox x:Name="ResizeModeBox" Width="110" Margin="0,0,6,0" SelectedIndex="0">
                            <ComboBoxItem Content="긴 변 (px)" />
                            <ComboBoxItem Content="가로 (px)" />
                            <ComboBoxItem Content="세로 (px)" />
                            <ComboBoxItem Content="퍼센트 (%)" />
                        </ComboBox>
                        <TextBox x:Name="ResizeValueBox" Style="{StaticResource AddressBox}" Width="64" Text="1920" />
                    </WrapPanel>
                    <CheckBox x:Name="NoUpscaleCheck" Content="원래보다 작은 그림은 키우지 않음" IsChecked="True" Margin="156,0,0,10" />

                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="CropCheck" Content="가운데 기준 자르기" Width="150" Margin="0,0,6,0" />
                        <ComboBox x:Name="CropRatioBox" Width="190" MaxDropDownHeight="520" />
                    </WrapPanel>
                    <CheckBox x:Name="FollowCheck" Content="사진 방향에 맞춰 비율을 뒤집어 적용 (3:4 ↔ 4:3)" IsChecked="True" Margin="156,0,0,10" />

                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource PaneSubLabel}" Text="회전" Width="150" Margin="0,0,6,0" />
                        <ComboBox x:Name="RotateBox" Width="110" SelectedIndex="0">
                            <ComboBoxItem Content="없음" />
                            <ComboBoxItem Content="오른쪽 90°" />
                            <ComboBoxItem Content="180°" />
                            <ComboBoxItem Content="왼쪽 90°" />
                        </ComboBox>
                    </WrapPanel>

                    <WrapPanel>
                        <TextBlock Style="{StaticResource PaneSubLabel}" Text="저장 형식" Width="150" Margin="0,0,6,0" />
                        <ComboBox x:Name="FormatBox" Width="110" Margin="0,0,12,0" SelectedIndex="0">
                            <ComboBoxItem Content="원래 형식" />
                            <ComboBoxItem Content="JPEG" />
                            <ComboBoxItem Content="PNG" />
                            <ComboBoxItem Content="BMP" />
                            <ComboBoxItem Content="TIFF" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource PaneSubLabel}" Text="JPEG 품질" Margin="0,0,6,0" />
                        <TextBox x:Name="QualityBox" Style="{StaticResource AddressBox}" Width="44" Text="90" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource PanePlaceholder}" Margin="0,10,0,0" FontSize="11"
                               Text="사진 방향(EXIF)은 늘 먼저 바로잡습니다. WebP·HEIC는 읽기만 되므로 형식을 JPEG·PNG로 바꿔야 저장됩니다." />
                </StackPanel>
            </Border>

            <!-- EXIF -->
            <Border Grid.Column="2" Style="{StaticResource GroupBox}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GroupTitle}" Text="메타데이터 (EXIF)" />

                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource PaneSubLabel}" Text="원래 값" Width="90" Margin="0,0,6,0" />
                        <ComboBox x:Name="PolicyBox" Width="220" SelectedIndex="0">
                            <ComboBoxItem Content="그대로 유지" />
                            <ComboBoxItem Content="위치 정보(GPS)만 지움" />
                            <ComboBoxItem Content="모두 지움" />
                        </ComboBox>
                    </WrapPanel>

                    <!-- 체크 + 값 줄은 코드에서 만듭니다. 항목이 ExifField 에 따라 정해지기 때문입니다. -->
                    <Grid x:Name="ExifGrid" />

                    <TextBlock Style="{StaticResource PanePlaceholder}" Margin="0,8,0,0" FontSize="11"
                               Text="체크한 항목만 바꿉니다. 비워 두고 체크하면 빈 값으로 씁니다. 작성자·태그는 ; 로 나눠 여럿을 적습니다. 촬영 일시 예: 2026-09-25 14:30. EXIF는 JPEG·TIFF에만 담깁니다." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 저장 위치 -->
        <Border Grid.Row="3" Style="{StaticResource GroupBox}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource GroupTitle}" Text="저장 위치" />

                <RadioButton x:Name="SubfolderRadio" Grid.Row="1" Grid.Column="0" GroupName="Output" IsChecked="True"
                             Content="원본 폴더 아래 하위 폴더" Width="190" Margin="0,0,6,6" />
                <TextBox x:Name="SubfolderBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource AddressBox}"
                         Width="160" HorizontalAlignment="Left" Text="resized" Margin="0,0,0,6"
                         GotKeyboardFocus="OnSubfolderFocus" />

                <RadioButton x:Name="FolderRadio" Grid.Row="2" Grid.Column="0" GroupName="Output"
                             Content="지정한 폴더" Width="190" Margin="0,0,6,0" />
                <TextBox x:Name="FolderBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource AddressBox}"
                         GotKeyboardFocus="OnFolderFocus" />
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DialogSmallButton}" Margin="6,0,0,0"
                        Click="OnBrowseFolder" Content="찾아보기…" />

                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource PaneSubLabel}" Text="이름 끝에 붙일 말" Margin="0,0,6,0" />
                    <TextBox x:Name="SuffixBox" Style="{StaticResource AddressBox}" Width="120"
                             ToolTip="예: _small → 사진_small.jpg. 비워 두면 원래 이름 그대로입니다. 같은 이름이 있으면 (2)처럼 번호를 붙입니다." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 시작 -->
        <DockPanel Grid.Row="4" Margin="0,10,0,10" LastChildFill="False">
            <TextBlock x:Name="CountLabel" DockPanel.Dock="Left" Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center" />

            <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}"
                    Content="닫기" Margin="8,0,0,0" IsCancel="True" />
            <Button x:Name="StartButton" DockPanel.Dock="Right" Style="{StaticResource DialogPrimaryButton}"
                    Content="시작" Click="OnStart" />
            <Button x:Name="OpenOutputButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}"
                    Content="결과 폴더 열기" Margin="0,0,8,0" IsEnabled="False" Click="OnOpenOutput"
                    ToolTip="마지막으로 저장한 폴더를 탐색기 칸의 새 탭으로 엽니다." />
        </DockPanel>

        <!-- 기록 -->
        <TextBox x:Name="Log"
                 Grid.Row="5"
                 IsReadOnly="True"
                 FontFamily="Consolas, D2Coding, 굴림체"
                 FontSize="12"
                 Background="{DynamicResource List.Background}"
                 Foreground="{DynamicResource Text.Primary}"
                 BorderBrush="{DynamicResource Pane.Border}"
                 BorderThickness="1"
                 Padding="6"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
    </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <local:PopupExplorer x:Name="SideExplorer" Grid.Column="2" Margin="0,12,12,12"
                                 Hint="그림을 두 번 누르거나 왼쪽 목록으로 끌어 놓으면 편집 목록에 들어갑니다." />
        </Grid>
    </DockPanel>

</Window>
