<UserControl x:Class="Explorer.App.Views.Dialogs.PopupExplorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown">

    <!--
        편집 창들이 오른쪽에 두는 간단한 탐색기입니다. 탭 줄, 뒤로·앞으로·위로, 주소, 목록.
        창마다 보여 줄 파일 종류(FileFilter)와 두 번 눌렀을 때 할 일(FilesActivated)만 다르게 정합니다.
        목록에서 끌면 윈도우 탐색기와 같은 모양(FileDrop)으로 넘기므로, 편집 창의 목록에 그대로 놓을 수 있습니다.
    -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="True">
            <Button x:Name="SideButton" DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}" Content="&#xE8AB;"
                    Click="OnToggleSide" ToolTip="탐색기를 오른쪽으로 옮깁니다" />
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}" Content="&#xE710;"
                    Click="OnNewTab" ToolTip="새 탭 (Ctrl+T). 지금 폴더를 하나 더 엽니다." />
            <ListBox x:Name="Tabs"
                     SelectionChanged="OnTabChanged"
                     PreviewMouseDown="OnTabsMouseDown"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="TabChrome" Margin="0,0,2,0" Padding="8,3,4,3" CornerRadius="3,3,0,0"
                                            Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Row.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Pane.HeaderBackground}" />
                                            <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Location}">
                            <TextBlock Text="{Binding Header}" MaxWidth="130" TextTrimming="CharacterEllipsis"
                                       FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}" />
                            <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                    Width="18" Height="18" Margin="4,0,0,0"
                                    Style="{StaticResource ToolButton}"
                                    Click="OnCloseTab" ToolTip="탭 닫기 (Ctrl+W, 가운데 클릭)" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
            <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource ToolIconButton}" Content="&#xE72B;"
                    Click="OnBack" ToolTip="뒤로 (Alt+←)" />
            <Button x:Name="ForwardButton" DockPanel.Dock="Left" Style="{StaticResource ToolIconButton}" Content="&#xE72A;"
                    Click="OnForward" ToolTip="앞으로 (Alt+→)" />
            <Button x:Name="UpButton" DockPanel.Dock="Left" Style="{StaticResource ToolIconButton}" Content="&#xE74A;"
                    Click="OnFolderUp" ToolTip="위로 (Backspace)" Margin="0,0,4,0" />
            <TextBox x:Name="FolderBox" Style="{StaticResource AddressBox}" KeyDown="OnFolderBoxKeyDown"
                     ToolTip="폴더 경로를 넣고 Enter. '내 PC' 도 됩니다." />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource PanePlaceholder}" FontSize="11" Margin="0,6,0,0"
                   Text="{Binding Hint, RelativeSource={RelativeSource AncestorType=UserControl}}" TextWrapping="Wrap" />
        <!--
            자세히 보기입니다. 머리글(이름·수정한 날짜·유형·크기)을 누르면 그 열로 정렬하고, 한 번 더 누르면 방향을 바꿉니다.
            폴더와 바로가기(.lnk)는 메인 탐색기처럼 늘 위에 모읍니다.
            GridView 는 ListView 안에 직접 둡니다(스타일로 넣으면 뷰 공유 예외가 납니다 — 진행상황 문서 '겪은 함정').
        -->
        <ListView x:Name="Files"
                  Style="{StaticResource FileListView}"
                  SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  GridViewColumnHeader.Click="OnHeaderClick"
                  MouseDoubleClick="OnFileDoubleClick"
                  PreviewMouseLeftButtonDown="OnFilesMouseDown"
                  PreviewMouseLeftButtonUp="OnFilesMouseUp"
                  PreviewMouseMove="OnFilesMouseMove"
                  KeyDown="OnFilesKeyDown">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource FileColumnHeader}">
                    <GridViewColumn Width="240">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader x:Name="NameHeader" Tag="Name" Content="이름" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Tip}">
                                    <Grid Width="16" Height="16" Margin="0,1,6,1">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Visibility="{Binding ShowGlyph, Converter={StaticResource BooleanToVisibility}}" />
                                        <Image Source="{Binding Icon}" Width="16" Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="118">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader x:Name="ModifiedHeader" Tag="LastWriteTime" Content="수정한 날짜" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ModifiedText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="84">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader x:Name="TypeHeader" Tag="Type" Content="유형" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TypeText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="72">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader x:Name="SizeHeader" Tag="Size" Content="크기" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                                           HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
