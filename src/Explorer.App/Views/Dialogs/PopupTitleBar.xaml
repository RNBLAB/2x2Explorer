<UserControl x:Class="Explorer.App.Views.Dialogs.PopupTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        편집 창들이 함께 쓰는 제목 줄입니다. 메인 창의 띠와 같은 모양입니다.
        왼쪽은 아이콘·제목, 가운데는 창마다 넣는 것(PDF 편집기는 즐겨찾기 단추), 오른쪽은 최소화·최대화·닫기.
        빈 자리를 끌면 창이 옮겨지고, 두 번 누르면 최대화합니다.
    -->
    <Border Height="36"
            Background="{DynamicResource Pane.HeaderBackground}"
            BorderBrush="{DynamicResource Pane.Border}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="OnBarPressed">
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource CaptionCloseButton}" Height="36"
                    Content="&#xE8BB;" Click="OnClose" ToolTip="닫기" />
            <Button x:Name="MaximizeButton" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Height="36"
                    Content="&#xE922;" Click="OnMaximize" ToolTip="최대화" />
            <Button x:Name="MinimizeButton" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Height="36"
                    Content="&#xE921;" Click="OnMinimize" ToolTip="최소화" />

            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0">
                <Image Source="pack://application:,,,/Resources/app.ico" Width="16" Height="16" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="TitleText" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Primary}" />
            </StackPanel>

            <ContentPresenter DockPanel.Dock="Left" VerticalAlignment="Center"
                              Content="{Binding Extra, RelativeSource={RelativeSource AncestorType=UserControl}}" ClipToBounds="True" />

            <!-- 남는 자리는 끌어 옮기는 손잡이입니다. -->
            <Border Background="Transparent" />
        </DockPanel>
    </Border>
</UserControl>
