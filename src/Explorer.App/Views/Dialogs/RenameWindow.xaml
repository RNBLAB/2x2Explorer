<Window x:Class="Explorer.App.Views.Dialogs.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Explorer.App.Views.Dialogs"
        Title="일괄 이름 바꾸기(베타)"
        Width="1500"
        Height="760"
        MinWidth="1000"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AllowDrop="True"
        Drop="OnFilesDropped"
        DragOver="OnFilesDragOver"
        PreviewKeyDown="OnWindowKeyDown"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 표(스프레드시트)를 앱 색 테마에 맞춥니다. DataGrid 의 기본 모양은 밝은 테마 전용입니다. -->

        <Style x:Key="SheetRowHeader" TargetType="DataGridRowHeader">
            <Setter Property="Background" Value="{DynamicResource Pane.HeaderBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pane.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="ToolTip" Value="끌어서 줄 순서를 바꿉니다. Ctrl·Shift 로 여러 줄을 고릅니다." />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRowHeader">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <TextBlock Text="{Binding Number}"
                                       FontSize="11"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsRowSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Row.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- '이름 변경 후' 칸: 문제가 있으면 칸을 물들이고 풍선 도움말로 사유를 보입니다 ('문제' 열 대신). -->
        <Style x:Key="AfterCell" TargetType="DataGridCell" BasedOn="{StaticResource SheetCell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                    <Setter Property="Background" Value="#55D9534F" />
                    <Setter Property="ToolTip" Value="{Binding Problem}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Row.Selected}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BeforeCell" TargetType="DataGridCell" BasedOn="{StaticResource SheetCell}">
            <Setter Property="ToolTip" Value="{Binding FullPath}" />
        </Style>

    </Window.Resources>

    <DockPanel>
        <local:PopupTitleBar x:Name="TitleBar" DockPanel.Dock="Top" />

        <Grid>
            <!-- 왼쪽은 이 창의 기능, 오른쪽은 편집 창들이 함께 쓰는 탐색기입니다 (58 : 42). 경계선은 끌어 옮깁니다. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58*" MinWidth="560" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="42*" MinWidth="240" />
            </Grid.ColumnDefinitions>

    <Grid Margin="16" Grid.Column="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 첫째 줄: 이름 전체에 거는 것들 -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,6"
                    Click="OnNormalize"
                    Content="정규화…  Ctrl+N"
                    ToolTip="이름을 요소(순번·날짜·문서번호·프로젝트명·본문·버전·작성자·비고)로 나눠 분석하고, 목표 패턴으로 다시 맞춥니다. 고른 줄이 없으면 모든 파일이 대상입니다." />
            <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,6"
                    Click="OnLower" Content="소문자  Ctrl+L" />
            <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,6"
                    Click="OnUpper" Content="대문자  Ctrl+U" />
            <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,16,6"
                    Click="OnRevert" Content="원래대로  Ctrl+0" />

            <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,6"
                    Click="OnCopyTable" Content="표 전체 복사  Ctrl+Shift+C"
                    ToolTip="머리글을 포함한 두 열을 탭으로 나눠 복사합니다. 엑셀·구글 스프레드시트에 그대로 붙습니다." />
            <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,6"
                    Click="OnOpenLogs" Content="기록…  Ctrl+G"
                    ToolTip="지난 일괄 이름 바꾸기 기록을 보고 되돌립니다." />
        </WrapPanel>

        <!-- 둘째 줄: 값을 받아 거는 것들 -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center" Text="확장자" Margin="0,0,6,6" />
            <TextBox x:Name="ExtensionBox" Style="{StaticResource AddressBox}" Width="70" Height="24" Padding="6,0" Margin="0,0,6,6" />
            <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,16,6"
                    Click="OnChangeExtension" Content="바꾸기  Ctrl+E"
                    ToolTip="비워 두고 누르면 확장자를 뗍니다." />

            <TextBlock Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center" Text="찾을 말" Margin="0,0,6,6" />
            <TextBox x:Name="FindBox" Style="{StaticResource AddressBox}" Width="110" Height="24" Padding="6,0" Margin="0,0,6,6" />
            <TextBlock Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center" Text="→" Margin="0,0,6,6" />
            <TextBox x:Name="ReplaceBox" Style="{StaticResource AddressBox}" Width="110" Height="24" Padding="6,0" Margin="0,0,6,6" />
            <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,16,6"
                    Click="OnReplace" Content="바꾸기  Ctrl+H" />

            <!-- 연번: 앞말을 치지 않고 위치·자릿수·구분자를 고릅니다. 고를 때마다 보기 글이 바뀝니다. -->
            <TextBlock Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center" Text="연번" Margin="0,0,6,6" />
            <ComboBox x:Name="NumberPositionBox" Width="64" Height="24" Margin="0,0,4,6" SelectedIndex="0"
                      SelectionChanged="OnNumberOptionChanged" ToolTip="연번을 붙일 자리">
                <ComboBoxItem Content="앞에" />
                <ComboBoxItem Content="뒤에" />
            </ComboBox>
            <ComboBox x:Name="NumberDigitsBox" Width="84" Height="24" Margin="0,0,4,6" SelectedIndex="0"
                      SelectionChanged="OnNumberOptionChanged" ToolTip="자릿수. 자동은 개수에 맞춥니다(9개까지 1, 99개까지 01 …).">
                <ComboBoxItem Content="자동" Tag="0" />
                <ComboBoxItem Content="1" Tag="1" />
                <ComboBoxItem Content="01" Tag="2" />
                <ComboBoxItem Content="001" Tag="3" />
                <ComboBoxItem Content="0001" Tag="4" />
            </ComboBox>
            <ComboBox x:Name="NumberSeparatorBox" Width="104" Height="24" Margin="0,0,6,6" SelectedIndex="0"
                      SelectionChanged="OnNumberOptionChanged" ToolTip="연번과 이름 사이 구분자">
                <ComboBoxItem Content="_ 언더바" Tag="_" />
                <ComboBoxItem Content="- 대시" Tag="-" />
                <ComboBoxItem Content="띄어쓰기" Tag=" " />
                <ComboBoxItem Content="없음" Tag="" />
            </ComboBox>
            <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,6"
                    Click="OnNumber" Content="붙이기  Ctrl+R"
                    ToolTip="고른 줄에, 고른 것이 없으면 모든 줄에 표의 차례대로 번호를 붙입니다." />
            <TextBlock x:Name="NumberSample" Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center" Margin="4,0,0,6" />
        </WrapPanel>

        <!-- 가운데: 왼쪽 1/3 변경 대상 목록, 오른쪽 2/3 스프레드시트 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="160" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- 변경 대상 목록 -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Height="26" LastChildFill="False">
                    <TextBlock x:Name="TargetsLabel" DockPanel.Dock="Left" Style="{StaticResource PaneSubLabel}"
                               VerticalAlignment="Center" Text="변경 대상 목록" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}" Content="&#xE74D;" Margin="6,0,0,0"
                            Click="OnRemoveTargets" ToolTip="고른 파일을 목록에서 뺍니다 (Delete). 파일은 지우지 않습니다." />
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}" Content="&#xE894;"
                            Click="OnClearAll" ToolTip="목록과 표를 모두 비웁니다" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}" Content="&#xE74B;"
                            Click="OnTargetsDown" ToolTip="고른 파일을 아래로 (Alt+↓). 표의 줄도 함께 옮겨집니다." />
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}" Content="&#xE74A;"
                            Click="OnTargetsUp" ToolTip="고른 파일을 위로 (Alt+↑). 표의 줄도 함께 옮겨집니다." />
                </DockPanel>

                <Grid>
                    <ListBox x:Name="Targets"
                             SelectionMode="Extended"
                             Background="{DynamicResource List.Background}"
                             Foreground="{DynamicResource Text.Primary}"
                             BorderBrush="{DynamicResource Pane.Border}"
                             BorderThickness="1"
                             AllowDrop="True"
                             SelectionChanged="OnTargetsSelectionChanged"
                             KeyDown="OnTargetsKeyDown"
                             PreviewMouseLeftButtonDown="OnTargetsMouseDown"
                             PreviewMouseLeftButtonUp="OnTargetsMouseUp"
                             PreviewMouseMove="OnTargetsMouseMove"
                             PreviewDragOver="OnTargetsDragOver"
                             PreviewDrop="OnTargetsDrop"
                             DragLeave="OnTargetsDragLeave">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding FullPath}" Margin="0,1">
                                    <TextBlock Text="{Binding Before}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Folder}" FontSize="10" Foreground="{DynamicResource Text.Muted}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyHint"
                               Style="{StaticResource PanePlaceholder}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="12"
                               IsHitTestVisible="False"
                               Text="이름을 바꿀 파일이나 폴더를&#x0a;여기로 끌어다 놓으십시오." />

                    <!-- 목록 안에서 끌 때 놓일 자리를 보이는 선입니다. -->
                    <Border x:Name="TargetsDropLine"
                            Height="2"
                            VerticalAlignment="Top"
                            Background="{DynamicResource Accent}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- 스프레드시트 -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Height="26" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource ToolIconButton}" Content="&#xE74A;"
                            Click="OnMoveUp" ToolTip="고른 줄을 위로 (Alt+↑)" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource ToolIconButton}" Content="&#xE74B;"
                            Click="OnMoveDown" ToolTip="고른 줄을 아래로 (Alt+↓)" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource ToolIconButton}" Content="&#xE738;" Margin="8,0,0,0"
                            Click="OnDeleteRows" ToolTip="고른 줄을 통째로 뺍니다 (Ctrl+-). 파일은 지우지 않습니다." />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource PaneSubLabel}" VerticalAlignment="Center" FontSize="11"
                               Text="Ctrl+C 복사 · Ctrl+V 붙여넣기 · Delete 칸 비우기 · 줄 번호를 끌어 순서 변경" />
                </DockPanel>

                <Grid>
                    <DataGrid x:Name="Sheet"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="CellOrRowHeader"
                              HeadersVisibility="All"
                              ClipboardCopyMode="ExcludeHeader"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="{DynamicResource Pane.Border}"
                              VerticalGridLinesBrush="{DynamicResource Pane.Border}"
                              Background="{DynamicResource List.Background}"
                              RowBackground="Transparent"
                              Foreground="{DynamicResource Text.Primary}"
                              BorderBrush="{DynamicResource Pane.Border}"
                              BorderThickness="1"
                              FontSize="12"
                              RowHeight="24"
                              ColumnHeaderStyle="{StaticResource SheetHeader}"
                              RowHeaderStyle="{StaticResource SheetRowHeader}"
                              AllowDrop="True"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewKeyDown="OnSheetKeyDown"
                              PreviewMouseLeftButtonDown="OnSheetMouseDown"
                              PreviewMouseLeftButtonUp="OnSheetMouseUp"
                              PreviewMouseMove="OnSheetMouseMove"
                              PreviewDragOver="OnSheetDragOver"
                              DragLeave="OnSheetDragLeave"
                              PreviewDrop="OnSheetDrop">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="이름 변경 전"
                                                Width="*"
                                                IsReadOnly="True"
                                                Binding="{Binding Before, Mode=OneWay}"
                                                CellStyle="{StaticResource BeforeCell}" />
                            <DataGridTextColumn Header="이름 변경 후"
                                                Width="*"
                                                Binding="{Binding After, UpdateSourceTrigger=PropertyChanged}"
                                                CellStyle="{StaticResource AfterCell}"
                                                EditingElementStyle="{StaticResource SheetEditBox}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 줄을 끌 때 놓일 자리를 보이는 선입니다. -->
                    <Border x:Name="DropLine"
                            Height="2"
                            VerticalAlignment="Top"
                            Background="{DynamicResource Accent}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </Grid>

        <!-- 아래 단추 -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="Summary"
                       DockPanel.Dock="Left"
                       Style="{StaticResource PaneSubLabel}"
                       VerticalAlignment="Center" />

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource DialogButton}"
                    Content="닫기"
                    Margin="8,0,0,0"
                    IsCancel="True" />

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource DialogPrimaryButton}"
                    Content="이름 바꾸기"
                    Click="OnRun" />
        </DockPanel>

    </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <local:PopupExplorer x:Name="SideExplorer" Grid.Column="2" Margin="0,12,12,12"
                                 Hint="파일·폴더를 두 번 누르거나 왼쪽 '변경 대상 목록'이나 표로 끌어 놓으면 들어갑니다." />
        </Grid>
    </DockPanel>

</Window>
