<Window x:Class="Explorer.App.Views.Dialogs.PdfEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Explorer.App.Views.Dialogs"
        Title="PDF 편집"
        Width="1900"
        Height="1000"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnWindowKeyDown"
        Closing="OnClosing"
        Closed="OnClosed"
        Background="{DynamicResource App.Background}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 썸네일 한 칸입니다. 고르면 강조색 테두리가 둘러집니다. -->
        <Style x:Key="ThumbItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel>
                            <Border x:Name="Frame"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    Background="{DynamicResource List.Background}"
                                    Padding="3">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="NumberBack" HorizontalAlignment="Center" Padding="4,0" Margin="0,2,0,0">
                                <TextBlock x:Name="Number"
                                           Text="{Binding Number}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Secondary}" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Pane.Border}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="NumberBack" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Number" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 즐겨찾기 단추 줄은 코드에서 만들어 제목 줄 가운데에 넣습니다 (FavoriteBar). -->
        <local:PopupTitleBar x:Name="TitleBar" DockPanel.Dock="Top" />

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 첫째 줄: 문서 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource DialogSmallButton}" Margin="0,0,6,0"
                    Click="OnOpen" Content="열기…" ToolTip="PDF 를 엽니다 (Ctrl+O). 지금 문서는 닫힙니다." />
            <Button DockPanel.Dock="Left" Style="{StaticResource DialogSmallButton}" Margin="0,0,16,0"
                    Click="OnReset" Content="초기화"
                    ToolTip="지금 작업을 폐기하고 빈 화면으로 돌아갑니다 (폐기할지 먼저 묻습니다).&#x0a;빈 화면에 그림을 넣어 PDF 로 저장하면 그림 → PDF 변환입니다." />

            <Button x:Name="AddButton" DockPanel.Dock="Left" Style="{StaticResource DialogSmallButton}" Margin="0,0,6,0"
                    Click="OnAddFiles" Content="페이지 추가…"
                    ToolTip="PDF 나 그림을 고른 쪽 뒤에 끼워 넣습니다 (병합). 고른 쪽이 없으면 맨 뒤에 붙입니다.&#x0a;오른쪽 목록이나 윈도우 탐색기에서 썸네일 칸으로 끌어 놓아도 됩니다." />
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource DialogSmallButton}" Margin="0,0,16,0"
                    Click="OnDeletePages" Content="페이지 삭제" ToolTip="고른 쪽을 뺍니다 (Delete). 원본 파일은 그대로입니다." />

            <CheckBox x:Name="FitA4Check" DockPanel.Dock="Left" IsChecked="True"
                      Content="그림 쪽은 A4에 맞춤"
                      ToolTip="끄면 그림 크기 그대로의 쪽을 만듭니다 (96 DPI 기준)." />

            <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource DialogPrimaryButton}"
                    Click="OnSave" Content="PDF로 저장…" ToolTip="Ctrl+S. 새 파일로 저장합니다. 열려 있는 원본 PDF 에는 덮어쓸 수 없습니다." />
        </DockPanel>

        <!-- 둘째 줄: 그림으로 내보내기 -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="8,6"
                Background="{DynamicResource Pane.Background}"
                BorderBrush="{DynamicResource Pane.Border}" BorderThickness="1" CornerRadius="4">
            <WrapPanel>
                <TextBlock Style="{StaticResource PaneLabel}" FontWeight="SemiBold" Margin="0,0,12,0" Text="그림으로 내보내기" />
                <TextBlock Style="{StaticResource PaneSubLabel}" Margin="0,0,6,0" Text="형식" />
                <ComboBox x:Name="ExportFormatBox" Width="70" Margin="0,0,12,0" SelectedIndex="0">
                    <ComboBoxItem Content="PNG" />
                    <ComboBoxItem Content="JPEG" />
                </ComboBox>
                <TextBlock Style="{StaticResource PaneSubLabel}" Margin="0,0,6,0" Text="해상도" />
                <TextBox x:Name="DpiBox" Style="{StaticResource AddressBox}" Width="48" Text="200" Margin="0,0,4,0"
                         ToolTip="72~600. 150 은 화면용, 300 은 인쇄용입니다." />
                <TextBlock Style="{StaticResource PaneSubLabel}" Margin="0,0,12,0" Text="DPI" />
                <ComboBox x:Name="ExportRangeBox" Width="90" Margin="0,0,16,0" SelectedIndex="0">
                    <ComboBoxItem Content="전체 쪽" />
                    <ComboBoxItem Content="고른 쪽" />
                </ComboBox>
                <RadioButton x:Name="ExportSubfolderRadio" GroupName="ExportTarget" IsChecked="True" Margin="0,0,6,0"
                             Content="하위 폴더" ToolTip="원본 PDF 가 있는 폴더 아래에 만듭니다." />
                <TextBox x:Name="ExportSubfolderBox" Style="{StaticResource AddressBox}" Width="140" Margin="0,0,12,0"
                         GotKeyboardFocus="OnExportSubfolderFocus" ToolTip="비워 두면 문서 이름을 씁니다." />
                <RadioButton x:Name="ExportFolderRadio" GroupName="ExportTarget" Margin="0,0,6,0" Content="지정 폴더" />
                <TextBox x:Name="ExportFolderBox" Style="{StaticResource AddressBox}" Width="220" Margin="0,0,4,0"
                         GotKeyboardFocus="OnExportFolderFocus" />
                <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,12,0" Click="OnBrowseExportFolder" Content="찾아보기…" />
                <Button x:Name="ExportButton" Style="{StaticResource DialogSmallButton}" Click="OnExport" Content="내보내기"
                        ToolTip="쪽마다 그림 한 장씩, 이름_p001.png 처럼 저장합니다. 같은 이름이 있으면 (2)를 붙입니다." />
            </WrapPanel>
        </Border>

        <!-- 세로 3분할: 썸네일 | 미리보기 | 탐색기. 경계선을 끌어 너비를 바꿉니다. -->
        <!--
            칸 너비는 코드가 셉니다 (UpdateColumns).
            썸네일은 A4 세로 3장이 줄지 않는 너비, 미리보기는 A4 세로 한 쪽이 높이에 꽉 차는 너비, 탐색기는 나머지입니다.
            경계선을 손으로 끌면 그 뒤로는 끈 너비를 따릅니다.
        -->
        <Grid x:Name="Body" Grid.Row="2" SizeChanged="OnBodySizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ThumbColumn" Width="478" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="PreviewColumn" Width="620" MinWidth="240" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- 썸네일 -->
            <Grid Grid.Column="0">
                <ListBox x:Name="Thumbs"
                         SelectionMode="Extended"
                         AllowDrop="True"
                         DragOver="OnThumbsDragOver"
                         DragLeave="OnThumbsDragLeave"
                         Drop="OnThumbsDrop"
                         SelectionChanged="OnThumbSelectionChanged"
                         ItemContainerStyle="{StaticResource ThumbItem}"
                         Background="{DynamicResource Pane.Background}"
                         BorderBrush="{DynamicResource Pane.Border}"
                         BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="190">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       ToolTip="{Binding Source}" />
                                <TextBlock Text="…" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Muted}"
                                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 끌어 놓는 동안 들어갈 자리를 강조색 세로선으로 보입니다. -->
                <Canvas x:Name="DropLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="DropMarker" Width="4" RadiusX="2" RadiusY="2"
                               Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                </Canvas>

                <TextBlock x:Name="ThumbsPlaceholder"
                           Style="{StaticResource PanePlaceholder}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           IsHitTestVisible="False"
                           Text="PDF 나 그림을 여기로 끌어 놓거나&#x0a;[열기…]·[페이지 추가…]를 누르십시오." />
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterDragged" />

            <!-- 미리보기 -->
            <Border x:Name="PreviewFrame" Grid.Column="2" Background="#FF2A2A2E" BorderBrush="{DynamicResource Pane.Border}" BorderThickness="1"
                    AllowDrop="True" DragOver="OnPreviewDragOver" Drop="OnPreviewDrop">
                <Grid>
                    <ScrollViewer x:Name="PreviewScroller"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="OnPreviewWheel"
                                  SizeChanged="OnPreviewSizeChanged">
                        <Image x:Name="PreviewImage"
                               Margin="16"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </ScrollViewer>
                    <TextBlock x:Name="PreviewPlaceholder"
                               Style="{StaticResource PanePlaceholder}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               TextAlignment="Center"
                               Text="왼쪽에서 쪽을 고르면 크게 보입니다. 휠로 쪽을 넘기고, Ctrl+휠로 확대·축소합니다.&#x0a;PDF·그림을 여기로 끌어 놓으면 새 작업으로 엽니다 (쪽 추가는 왼쪽 썸네일 칸으로)." />

                    <!-- 맞춤 단추. 미리보기 위 오른쪽 구석에 띄웁니다. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,22,0" Opacity="0.92">
                        <!-- 맞춤 방식 하나로 모은 드롭다운입니다. 누르면 자동·너비·높이 가운데 고르는 메뉴가 펼쳐집니다. -->
                        <Button x:Name="FitButton" Style="{StaticResource DialogSmallButton}"
                                Click="OnFitButton" Content="자동 맞춤 ▾"
                                ToolTip="미리보기 맞춤 방식을 고릅니다.&#x0a;자동: 가로 쪽은 너비, 세로 쪽은 높이에 맞춤 (Ctrl+0)">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="FitMenu">
                                    <MenuItem x:Name="FitAutoItem" Header="자동 맞춤" InputGestureText="Ctrl+0"
                                              Click="OnFitAuto" ToolTip="가로 쪽은 너비 맞춤, 세로 쪽은 높이 맞춤" />
                                    <MenuItem x:Name="FitWidthItem" Header="너비 맞춤" Click="OnFitWidth"
                                              ToolTip="쪽 너비를 미리보기 칸 너비에 맞춥니다" />
                                    <MenuItem x:Name="FitHeightItem" Header="높이 맞춤" Click="OnFitHeight"
                                              ToolTip="쪽 전체가 한눈에 보이게 높이에 맞춥니다" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterDragged" />

            <!-- 탐색기: 편집 창들이 함께 쓰는 간단한 탐색기입니다 (PopupExplorer). -->
            <local:PopupExplorer x:Name="SideExplorer" Grid.Column="4"
                                 Hint="PDF·그림을 두 번 누르거나 왼쪽 썸네일 칸으로 끌어 놓으면 쪽으로 들어갑니다." />
        </Grid>

        <!-- 상태 줄 -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="True">
            <TextBlock x:Name="PageLabel" DockPanel.Dock="Right" Style="{StaticResource PaneSubLabel}" Margin="12,0,0,0" />
            <TextBlock x:Name="StatusLabel" Style="{StaticResource PaneSubLabel}" />
        </DockPanel>
    </Grid>
    </DockPanel>

</Window>
