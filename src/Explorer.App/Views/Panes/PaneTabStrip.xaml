<UserControl x:Class="Explorer.App.Views.Panes.PaneTabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext는 PaneViewModel입니다. -->
    <!--
        폴더를 탭 줄에 끌어다 놓으면 그 폴더를 새 탭으로 엽니다(목록·윈도우 탐색기 어디서 끌든 같음).
        탭 순서 바꾸기는 마우스 붙잡기로 따로 하므로 이 끌어 놓기와 겹치지 않습니다.
    -->
    <Grid x:Name="Root"
          Background="Transparent"
          AllowDrop="True"
          DragEnter="OnStripDragOver"
          DragOver="OnStripDragOver"
          DragLeave="OnStripDragLeave"
          Drop="OnStripDrop"
          ContextMenuOpening="OnContextMenuOpening">

        <!--
            패널·탭 명령은 모두 여기 들어 있습니다.
            상단 바를 탭에게 전부 내주는 대신, 오른쪽 클릭으로 부릅니다.
            빈 자리에서 눌러도 열리도록 Grid 에 투명 배경을 깔았습니다.
        -->
        <Grid.ContextMenu>
            <ContextMenu Style="{StaticResource DarkContextMenu}">
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}" />
                </ContextMenu.Resources>

                <MenuItem Header="새 탭"
                          InputGestureText="Ctrl+T"
                          Command="{Binding NewTabCommand}" />
                <MenuItem Header="탭 복제"
                          Command="{Binding DuplicateTabCommand}" />
                <MenuItem Header="탭 닫기"
                          InputGestureText="Ctrl+W"
                          Command="{Binding CloseTabCommand}" />
                <MenuItem Header="방금 닫은 탭 다시 열기"
                          Command="{Binding ReopenTabCommand}" />
                <MenuItem Header="다른 탭 모두 닫기"
                          Command="{Binding CloseOtherTabsCommand}" />

                <Separator />

                <!-- 즐겨찾기 목록은 열릴 때 코드에서 채웁니다. -->
                <MenuItem Tag="favorites" Header="즐겨찾기로 이동" />
                <MenuItem Tag="addfavorite" Header="이 폴더를 즐겨찾기에 추가" Click="OnAddFavorite" />

                <Separator />

                <MenuItem Header="{Binding StartPathDisplay}" IsEnabled="False" />
                <MenuItem Header="이 폴더를 시작 위치로"
                          Command="{Binding SetStartPathCommand}" />

                <Separator />

                <MenuItem Header="시작할 때 시작 위치만 열기"
                          IsCheckable="True"
                          IsChecked="{Binding IsStartPathMode, Mode=OneWay}"
                          Command="{Binding StartupModeCommand}"
                          CommandParameter="StartPath" />
                <MenuItem Header="시작할 때 지난 탭 복원"
                          IsCheckable="True"
                          IsChecked="{Binding IsRestoreTabsMode, Mode=OneWay}"
                          Command="{Binding StartupModeCommand}"
                          CommandParameter="RestoreTabs" />

                <Separator />

                <!-- 창 설정에서 칸 역할을 고르는 것과 같습니다. 탐색기 칸이 하나뿐이면 창이 막습니다. -->
                <MenuItem Header="이 칸을 미리보기로 전환" Click="OnSwitchToPreview" />
            </ContextMenu>
        </Grid.ContextMenu>

        <DockPanel LastChildFill="True">

        <!-- 탭 초기화는 오른쪽 끝에 붙여 둡니다. 탭이 아무리 많아도 자리를 지킵니다. -->
        <Button DockPanel.Dock="Right"
                Style="{StaticResource TabButton}"
                Content="&#xE7A7;"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Click="OnResetTabs"
                ToolTip="탭 초기화 — 탭을 모두 닫고 시작 위치 하나만 엽니다" />

        <!--
            탭은 왼쪽부터 채우고, 넘치면 가로로 스크롤합니다.
            스크롤 막대는 숨기고 마우스 휠로 좌우로 굴립니다.
        -->
        <!-- 탭이 넘칠 때만 나옵니다. 한 번에 탭 하나만큼 밉니다. -->
        <Button x:Name="ScrollLeftButton"
                DockPanel.Dock="Left"
                Style="{StaticResource TabButton}"
                Content="&#xE76B;"
                Margin="0,0,2,0"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Click="OnScrollLeft"
                ToolTip="탭 왼쪽으로" />

        <Button x:Name="ScrollRightButton"
                DockPanel.Dock="Right"
                Style="{StaticResource TabButton}"
                Content="&#xE76C;"
                Margin="2,0,0,0"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Click="OnScrollRight"
                ToolTip="탭 오른쪽으로" />

        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Left"
                      ScrollChanged="OnStripScrollChanged"
                      PreviewMouseWheel="OnStripMouseWheel"
                      PreviewMouseMove="OnStripMouseMove"
                      PreviewMouseLeftButtonUp="OnStripMouseUp"
                      PreviewMouseRightButtonUp="OnStripRightMouseUp"
                      LostMouseCapture="OnStripLostCapture">
            <StackPanel Orientation="Horizontal">

                <ItemsControl x:Name="TabItems" ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                                탭 하나입니다. 너비를 못박아 두어 이름이 길든 짧든 자리가 같습니다.
                                껍데기에는 여백을 두지 않습니다. 여백을 두면 색이 그만큼 안으로 들어가
                                탭마다 흰 테두리가 생깁니다. 여백은 안쪽 글자 줄이 집니다.
                            -->
                            <Border x:Name="Chrome"
                                    Style="{StaticResource TabChrome}"
                                    Width="100"
                                    Padding="0"
                                    Margin="0"
                                    ToolTip="{Binding CurrentPath}"
                                    MouseDown="OnTabMouseDown">
                                <!--
                                    색은 안쪽에 칠합니다.
                                    바깥 껍데기의 바탕은 마우스 얹기·고르기가 쓰고 있어, 거기에 색을 두면 서로 덮습니다.
                                    색 없는 작업 탭은 여기가 투명이라 예전 모습 그대로입니다.
                                -->
                                <Border Background="{Binding TabFillBrush}" CornerRadius="3,3,0,0">
                                    <Grid Margin="8,3,4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="Label"
                                                   Grid.Column="0"
                                                   Text="{Binding Header}"
                                                   Style="{StaticResource TabLabel}"
                                                   MaxWidth="1000"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <Button Grid.Column="1"
                                                Style="{StaticResource TabButton}"
                                                Content="&#xE8BB;"
                                                Command="{Binding CloseTabCommand}"
                                                ToolTip="탭 닫기 (가운데 클릭)" />
                                    </Grid>
                                </Border>
                            </Border>

                            <DataTemplate.Triggers>
                                <Trigger SourceName="Chrome" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Row.Hover}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Pane.Background}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                </DataTrigger>

                                <!--
                                    색을 받은 탭은 글자를 짙게 둡니다.
                                    열 가지 색이 모두 밝은 쪽이라 흰 글자는 묻힙니다.
                                -->
                                <DataTrigger Binding="{Binding HasTabColor}" Value="True">
                                    <Setter TargetName="Label" Property="Foreground" Value="#FF1F1F26" />
                                </DataTrigger>


                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 마지막 탭 바로 뒤에 붙습니다. -->
                <Button Style="{StaticResource TabButton}"
                        Content="&#xE710;"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding NewTabCommand}"
                        ToolTip="새 탭 (Ctrl+T)" />

            </StackPanel>
        </ScrollViewer>

        </DockPanel>

        <!--
            끌고 있는 탭의 그림자입니다. 마우스를 따라다닙니다.
            탭 줄 밖, 다른 패널 위까지 따라가야 하므로 창 밖으로 나갈 수 있는 Popup 으로 띄웁니다.
        -->
        <Popup x:Name="DragGhost"
               Placement="Absolute"
               AllowsTransparency="True"
               IsHitTestVisible="False"
               PopupAnimation="None"
               Focusable="False">
            <Border Background="{DynamicResource Pane.Background}"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Opacity="0.85"
                    Padding="0">
                <Rectangle x:Name="GhostFill" />
            </Border>
        </Popup>

    </Grid>

</UserControl>
