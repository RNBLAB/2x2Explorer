<UserControl x:Class="Explorer.App.Views.Panes.PaneHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">

    <!-- 모든 패널이 공유하는 껍데기입니다. 파일 패널과 미리보기 패널은 본문만 다릅니다. -->
    <Border x:Name="PaneBorder"
            Background="{DynamicResource Pane.Background}"
            BorderBrush="{DynamicResource Pane.Border}"
            BorderThickness="1"
            CornerRadius="4"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                상단 바입니다.
                0열: 미리보기 패널의 이름표 자리입니다. 파일 패널에서는 숨기므로 폭이 0이 됩니다.
                1열: 탭 스트립. 왼쪽부터 채우고 넘치면 잘립니다.
                     패널·탭 명령은 탭 스트립을 오른쪽 클릭해서 부릅니다.
            -->
            <Grid Grid.Row="0"
                  Height="{DynamicResource Pane.HeaderHeight}"
                  Background="{DynamicResource Pane.HeaderBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="MenuHost"
                                  Grid.Column="0"
                                  Margin="8,0,4,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />

                <!-- 탭 스트립은 남는 폭을 모두 차지하고, 안에서 오른쪽에 붙습니다. -->
                <ContentPresenter x:Name="TabStripHost"
                                  Grid.Column="1"
                                  Margin="6,0,8,0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ClipToBounds="True" />
            </Grid>

            <ContentPresenter x:Name="BodyHost" Grid.Row="1" Margin="10" />
        </Grid>

    </Border>

</UserControl>
