<UserControl x:Class="Explorer.App.Views.Panes.PaneBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="clr-namespace:Explorer.App.Views.Panes"
             SizeChanged="OnSizeChanged">

    <!-- DataContext는 PaneViewModel입니다. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!--
                앞칸과 뒷칸입니다. 어느 쪽이 탐색 창이고 어느 쪽이 목록인지는 코드에서 정합니다.
                오른쪽 끝에 놓인 칸에서는 탐색 창을 뒷칸으로 보냅니다.
            -->
            <ColumnDefinition x:Name="FrontColumn" Width="*" />
            <ColumnDefinition x:Name="TreeSplitColumn" Width="0" />
            <ColumnDefinition x:Name="BackColumn" Width="0" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            탐색 창입니다. 세로로 긴 칸에서만 보입니다.
            뿌리는 드라이브이고, 마디를 펼칠 때 비로소 아래를 읽습니다.
        -->
        <Border x:Name="TreeBox"
                Grid.Column="0"
                Padding="0,0,6,0"
                UseLayoutRounding="True"
                Visibility="{Binding ShowTree, Converter={StaticResource BooleanToVisibility}}">
            <TreeView x:Name="FolderTree"
                      ItemsSource="{Binding Tree.Roots}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource Text.Primary}"
                      FontSize="12"
                      SelectedItemChanged="OnTreeSelectionChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        <Setter Property="Padding" Value="4,2" />

                        <!--
                            껍데기를 직접 그립니다.
                            기본 껍데기는 아래 가지가 없으면 세모를 아예 감추는데,
                            그러면 폴더를 고를 때마다 세모가 나타났다 사라져 고장처럼 보입니다.
                            여기서는 아래가 비어 있어도 세모를 그대로 둡니다.
                        -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <StackPanel>
                                        <Border x:Name="Row"
                                                Background="Transparent"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <ToggleButton Grid.Column="0"
                                                              Focusable="False"
                                                              ClickMode="Press"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent"
                                                                    Width="16"
                                                                    Height="16">
                                                                <TextBlock x:Name="Glyph"
                                                                           Text="&#x25B7;"
                                                                           FontSize="9"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Text.Secondary}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Glyph" Property="Text" Value="&#x25BC;" />
                                                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>

                                                <ContentPresenter Grid.Column="1"
                                                                  ContentSource="Header"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <ItemsPresenter x:Name="Branches"
                                                        Margin="14,0,0,0"
                                                        Visibility="Collapsed" />
                                    </StackPanel>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter TargetName="Branches" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Row.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Row.Selected}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- 탐색 창과 목록 사이의 가룻대입니다. 끌어 놓은 너비는 설정에 남습니다. -->
        <GridSplitter x:Name="TreeSplitter"
                      Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource Pane.Border}"
                      Opacity="0.6"
                      ResizeBehavior="PreviousAndNext"
                      DragCompleted="OnTreeSplitterMoved"
                      Visibility="{Binding ShowTree, Converter={StaticResource BooleanToVisibility}}" />

        <panes:FileListView x:Name="ListBox" Grid.Column="2" DataContext="{Binding SelectedTab}" />

        <!--
            미리보기 자리입니다. 폭은 코드에서 높이에 맞춰 잡습니다.
            A4 세로비율(210:297)이라 높이가 정해지면 폭이 따라옵니다.
        -->
        <Border x:Name="PreviewBox"
                Grid.Column="3"
                Margin="10,0,0,0"
                Padding="10,0,0,0"
                BorderBrush="{DynamicResource Pane.Border}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding ShowPreview, Converter={StaticResource BooleanToVisibility}}">
            <panes:PreviewPane DataContext="{Binding Preview}" />
        </Border>

    </Grid>

</UserControl>
