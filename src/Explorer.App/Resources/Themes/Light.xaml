<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark.xaml과 키가 같아야 합니다. 하나만 바꾸면 그 키를 쓰는 곳이 깨집니다. -->
    <SolidColorBrush x:Key="App.Background" Color="#FFF2F2F5" />
    <SolidColorBrush x:Key="Pane.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Pane.HeaderBackground" Color="#FFE9E9EE" />
    <SolidColorBrush x:Key="Pane.Border" Color="#FFD3D3DB" />
    <SolidColorBrush x:Key="Pane.BorderActive" Color="#FF2A6FE0" />
    <SolidColorBrush x:Key="Text.Primary" Color="#FF1B1B20" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF585863" />
    <SolidColorBrush x:Key="Text.Muted" Color="#FF8A8A96" />
    <SolidColorBrush x:Key="Accent" Color="#FF2A6FE0" />
    <SolidColorBrush x:Key="Warning" Color="#FFB4741A" />

    <!-- 목록 -->
    <SolidColorBrush x:Key="List.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Row.Hover" Color="#FFEDEDF2" />
    <SolidColorBrush x:Key="Row.Selected" Color="#FFCFE0FA" />

    <!-- 툴팁 -->
    <SolidColorBrush x:Key="ToolTip.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ToolTip.Border" Color="#FFC6C6D0" />

    <!-- 입력 -->
    <SolidColorBrush x:Key="Input.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Input.Border" Color="#FFC6C6D0" />
    <SolidColorBrush x:Key="Button.Hover" Color="#FFE2E2E9" />
    <SolidColorBrush x:Key="Button.Pressed" Color="#FFD2D2DC" />

    <!-- 코드 미리보기 색입니다. 주석·글월·수·미리 잡아 둔 낱말 넷만 씁니다. -->
    <SolidColorBrush x:Key="Code.Comment" Color="#FF008000" />
    <SolidColorBrush x:Key="Code.Quoted" Color="#FFA31515" />
    <SolidColorBrush x:Key="Code.Number" Color="#FF098658" />
    <SolidColorBrush x:Key="Code.Keyword" Color="#FF0000FF" />

</ResourceDictionary>
